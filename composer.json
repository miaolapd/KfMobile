{
    "name": "miaolapd/kfmobile",
    "description": "the KF mobile website",
    "type": "project",
    "keywords": [
        "KfMobile",
        "ThinkPHP",
        "phpQuery",
        "Bootstrap"
    ],
    "homepage": "https://github.com/miaolapd/KfMobile",
    "license": "MIT",
    "authors": [
        {
            "name": "miaolapd",
            "email": "miaolapd@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "topthink/framework": "^8.1",
        "topthink/think-view": "^2.0",
        "jaeger/phpquery-single": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
